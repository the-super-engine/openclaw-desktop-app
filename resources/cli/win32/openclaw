#!/bin/sh
# OpenClaw CLI wrapper for Git Bash / MSYS2 on Windows
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

case "$1" in
  update)
    echo "openclaw is managed by OpenClaw Desktop (bundled version)."
    echo ""
    echo "To update openclaw, update OpenClaw Desktop:"
    echo "  Open app > Settings > Check for Updates"
    exit 0
    ;;
esac

export OPENCLAW_EMBEDDED_IN="OpenClaw-Desktop"
ELECTRON_RUN_AS_NODE=1 exec "$INSTALL_DIR/openclaw-desktop.exe" "$INSTALL_DIR/resources/openclaw/openclaw.mjs" "$@"
